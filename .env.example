# Copie este arquivo para ".env" e ajuste os valores.

# Telegram (token do @BotFather)
TELEGRAM_BOT_TOKEN=COLOQUE_SEU_TOKEN_AQUI

# (Opcional) Chat ID do administrador para receber lembretes também.
ADMIN_CHAT_ID=

# Caminho da planilha (.xlsx/.xlsm). Se vazio, o app/bot tenta achar automaticamente na pasta atual.
# Exemplos:
# WORKBOOK_PATH=dist_novo\\Planilha.xlsx
# WORKBOOK_PATH=C:\\Users\\SeuNome\\Desktop\\Planilha.xlsx
WORKBOOK_PATH=dist_novo\AssistentePlanilha\Planilha_Comunicacao_Visual - EDIT.xlsx

# Robô copia o padrão da linha 1048576 e não reformata a planilha inteira (1=sim, 0=não).
SPREADSHEET_PRESERVE_LAYOUT=1

# API n8n (integracao WhatsApp / Telegram)
N8N_API_HOST=127.0.0.1
N8N_API_PORT=8765
# N8N_API_KEY=defina_uma_senha_forte_aqui

# Modelo do Whisper usado no Telegram (tiny, base, small, medium, large-v2...)
WHISPER_MODEL=small

# (Opcional) Diretório local de modelos Whisper (para rodar sem baixar).
# O repositório já inclui a pasta models/ — use o caminho abaixo após git clone.
WHISPER_LOCAL_MODEL_DIR=models
