{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Preparar projeto (setup)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_project.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "2. Iniciar Telegram",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/telegram_bot.py",
      "python": "${workspaceFolder}/.venv_native/Scripts/python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "App desktop (launcher)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/launcher.py",
      "python": "${workspaceFolder}/.venv_native/Scripts/python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "API n8n",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/n8n_api.py",
      "python": "${workspaceFolder}/.venv_native/Scripts/python.exe",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
