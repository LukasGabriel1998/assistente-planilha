{
  "name": "Assistente Planilha - Telegram via API",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/api/v1/message",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"conversation_id\": \"telegram:{{ $json.message.chat.id }}\",\n  \"text\": \"{{ $json.message.text }}\",\n  \"channel\": \"telegram\"\n}",
        "options": {}
      },
      "id": "http-planilha",
      "name": "API Planilha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.reply }}",
        "additionalFields": {}
      },
      "id": "telegram-reply",
      "name": "Responder Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "API Planilha", "type": "main", "index": 0 }]]
    },
    "API Planilha": {
      "main": [[{ "node": "Responder Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
